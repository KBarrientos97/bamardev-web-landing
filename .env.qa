# Usado por `npm run build:qa` (vite build --mode qa).
VITE_API_URL=https://api-qa.bamardev.com/api

# Cloudflare Turnstile (captcha del formulario de contacto). La site key NO es
# secreta: viaja en el HTML. La secreta vive sólo en el VPS (TURNSTILE_SECRET).
# Sin esta variable no se dibuja el widget ni se manda token.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFPk1RouUe7EXrPO

# La app web del negocio: a donde salta el alta de la landing (prueba del
# Emprendedor) con la sesión ya abierta.
VITE_APP_URL=https://app-qa.bamardev.com
